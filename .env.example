# Copy to .env and change every password before running anything outside your own machine.
# .env is git-ignored. In production use Docker secrets or a vault instead.
#
# Passwords may contain any character. Docker Compose reads this file, so:
#   - wrap a password with symbols or spaces in double quotes, and
#   - write a dollar sign as $$ (Compose would otherwise treat $x as a variable).
#   Example: the password  p@ss:w/rd#1?%'$ x  is written as
#   SALES_DB_PASSWORD="p@ss:w/rd#1?%'$$ x"

DOMAIN=localhost
ACME_EMAIL=you@example.com
ENVIRONMENT=local

# PostgreSQL superuser (only used by the init script, never by the services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# One database user per service
AUTH_DB_PASSWORD=change-me-auth
BRANCH_DB_PASSWORD=change-me-branch
CATALOG_DB_PASSWORD=change-me-catalog
INVENTORY_DB_PASSWORD=change-me-inventory
STOCKCOUNT_DB_PASSWORD=change-me-stockcount
PRESCRIPTION_DB_PASSWORD=change-me-prescription
CONTROLLED_DB_PASSWORD=change-me-controlled
SALES_DB_PASSWORD=change-me-sales
CUSTOMERS_DB_PASSWORD=change-me-customers
PURCHASING_DB_PASSWORD=change-me-purchasing
REPORTS_DB_PASSWORD=change-me-reports
NOTIFICATION_DB_PASSWORD=change-me-notification
DOCUMENT_DB_PASSWORD=change-me-document
AI_DB_PASSWORD=change-me-ai

RABBITMQ_USER=pharmacy
RABBITMQ_PASSWORD=change-me-rabbit

REDIS_URL=redis://redis:6379/0

# File storage (S3-compatible) – not used yet; chosen before sprint S4.
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Calls between services (/internal/v1, never through Traefik). Production: at least 32
# random characters: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SERVICE_TOKEN=change-me-to-a-long-random-service-token

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Encrypts 2FA secrets. Empty = derived from JWT_SECRET (fine locally).
# Production: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# Notification
TELEGRAM_BOT_TOKEN=

# AI service only
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-flash
DEEPSEEK_MODEL_REASONING=deepseek-v4-pro
