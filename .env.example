# Copy to .env and change every password before running anything outside your own machine.
# .env is git-ignored. In production use Docker secrets or a vault instead.
#
# Passwords may contain any character. Docker Compose reads this file, so:
#   - wrap a password with symbols or spaces in double quotes, and
#   - write a dollar sign as $$ (Compose would otherwise treat $x as a variable).
#   Example: the password  p@ss:w/rd#1?%'$ x  is written as
#   SALES_DB_PASSWORD="p@ss:w/rd#1?%'$$ x"

DOMAIN=localhost
ACME_EMAIL=you@example.com
ENVIRONMENT=local
# development allows `make seed-demo` (a year of demo data in the reports service, DEMO branches only).
# Leave empty on a real pharmacy's server.
APP_ENV=development

# PostgreSQL superuser (only used by the init script, never by the services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# One database user per service
AUTH_DB_PASSWORD=change-me-auth
BRANCH_DB_PASSWORD=change-me-branch
CATALOG_DB_PASSWORD=change-me-catalog
INVENTORY_DB_PASSWORD=change-me-inventory
STOCKCOUNT_DB_PASSWORD=change-me-stockcount
PRESCRIPTION_DB_PASSWORD=change-me-prescription
CONTROLLED_DB_PASSWORD=change-me-controlled
SALES_DB_PASSWORD=change-me-sales
CUSTOMERS_DB_PASSWORD=change-me-customers
PURCHASING_DB_PASSWORD=change-me-purchasing
REPORTS_DB_PASSWORD=change-me-reports
NOTIFICATION_DB_PASSWORD=change-me-notification
DOCUMENT_DB_PASSWORD=change-me-document
AI_DB_PASSWORD=change-me-ai

RABBITMQ_USER=pharmacy
RABBITMQ_PASSWORD=change-me-rabbit

REDIS_URL=redis://redis:6379/0

# File storage: SeaweedFS (S3 API), internal network only. Rx photos and PDFs.
# Production: a long random secret (python -c 'import secrets; print(secrets.token_urlsafe(32))').
S3_ACCESS_KEY=pharmacy-files
S3_SECRET_KEY=change-me-s3-secret-key

# Calls between services (/internal/v1, never through Traefik). Production: at least 32
# random characters: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SERVICE_TOKEN=change-me-to-a-long-random-service-token

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Encrypts 2FA secrets. Empty = derived from JWT_SECRET (fine locally).
# Production: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# KHQR. fake: development only (production refuses it); bakong: the real NBC API; payway: ABA PayWay.
# The shared account below; a branch can have its own (branch settings → khqr).
KHQR_PROVIDER=fake
KHQR_ACCOUNT_ID=pharmacy@devb
KHQR_MERCHANT_NAME=Pharmacy (dev)
KHQR_CITY=Phnom Penh
KHQR_MERCHANT_ID=
KHQR_ACQUIRING_BANK=
# Bakong Open API token (api-bakong.nbc.gov.kh; it expires: renew it)
BAKONG_TOKEN=
# ABA PayWay (KHQR_PROVIDER=payway). Sandbox https://checkout-sandbox.payway.com.kh, live https://checkout.payway.com.kh
# (a full endpoint URL also works). PAYWAY_API_KEY is what ABA calls "Public Key" (the HMAC secret). The RSA key
# files are compose secrets: put them in secrets/ (git-ignored; scripts/payway_setup.py does it) and name them here.
# PAYWAY_CALLBACK_URL: the public https URL of /api/sales/v1/payments/payway/callback (empty: polling only).
# Check with `make payway-check`. Never commit real values.
PAYWAY_BASE_URL=
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_RSA_PUBLIC_KEY_SOURCE=./secrets/payway_rsa_public.pem
PAYWAY_RSA_PRIVATE_KEY_SOURCE=./secrets/payway_rsa_private.pem
PAYWAY_CALLBACK_URL=
# PayWay checkout at the till: the web app's address, where the PayWay window returns (/pos/payway-return)
PAYWAY_WEB_URL=http://localhost

# Notification
TELEGRAM_BOT_TOKEN=
# Only to point the bot at a test server; the real Bot API by default.
TELEGRAM_API_BASE=https://api.telegram.org

# AI service only
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-flash
DEEPSEEK_MODEL_REASONING=deepseek-v4-pro
