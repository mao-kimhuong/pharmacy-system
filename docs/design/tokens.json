{
  "$source": "docs/design/project/Design System.dc.html (Claude Design, v1.0, 31/10/2026); radii and shadows read from the frames",
  "color": {
    "primary": {
      "50": "#EFF8F7",
      "100": "#DDF1EF",
      "300": "#7CC6BF",
      "500": "#13908A",
      "600": "#0E7470",
      "700": "#0B5F5C",
      "900": "#073B39"
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F6F8F7",
      "100": "#EEF1F0",
      "200": "#DDE2E1",
      "300": "#C4CBCA",
      "400": "#8C9594",
      "500": "#66706F",
      "700": "#3A4645",
      "900": "#17201F"
    },
    "canvas": "#E9EDEC",
    "focus-ring": "#CDEBE8",
    "semantic": {
      "success": "#1E7B47",
      "success-bg": "#E3F3E9",
      "warning": "#D99A1E",
      "warning-bg": "#FDF1D6",
      "danger": "#B42318",
      "danger-bg": "#FDE8E6",
      "info": "#1F5FA8",
      "info-bg": "#E4EEFA"
    },
    "safety": {
      "$note": "Reserved for safety badges only; never reused for other UI. Badges are icon + colour + text, never colour alone.",
      "rx": { "bg": "#3438A0", "fg": "#FFFFFF", "icon": "℞" },
      "controlled": { "bg": "#A01D52", "fg": "#FFFFFF", "icon": "◆" },
      "expired": { "bg": "#B42318", "fg": "#FFFFFF", "icon": "✕" },
      "near-expiry": { "bg": "#F3C24B", "fg": "#3D2A00", "icon": "◷" },
      "quarantine": { "bg": "#9A4A0A", "fg": "#FFFFFF", "icon": "⊘" },
      "allergy": { "bg": "#B42318", "fg": "#FFFFFF", "icon": "!" },
      "recalled": { "bg": "#17201F", "fg": "#FFFFFF", "icon": "↺" },
      "hamper": { "bg": "#6B5A12", "fg": "#FFFFFF", "icon": "▣" },
      "promotion": { "bg": "#6D3FB0", "fg": "#FFFFFF", "icon": "%" },
      "duplicate-therapy": { "bg": "#FDF1D6", "fg": "#7A4F00", "icon": "≡" }
    },
    "status-pill": {
      "$note": "fg / bg / border / dot. Same pill everywhere (Design System §status).",
      "neutral": { "fg": "#3A4645", "bg": "#EEF1F0", "bd": "#DDE2E1", "dot": "#8C9594" },
      "info": { "fg": "#1F5FA8", "bg": "#E4EEFA", "bd": "#C3D7F0", "dot": "#1F5FA8" },
      "primary": { "fg": "#0B5F5C", "bg": "#DDF1EF", "bd": "#B8E0DC", "dot": "#13908A" },
      "warning": { "fg": "#7A4F00", "bg": "#FDF1D6", "bd": "#F0D48E", "dot": "#D99A1E" },
      "success": { "fg": "#1E6B3F", "bg": "#E3F3E9", "bd": "#BFE2CC", "dot": "#2E9B5C" },
      "danger": { "fg": "#A3201A", "bg": "#FDE8E6", "bd": "#F4C3BD", "dot": "#D23C2F" },
      "cancelled": { "fg": "#A3201A", "bg": "#FFFFFF", "bd": "#E8A39C", "dot": "#D23C2F", "text-decoration": "line-through" },
      "purple": { "fg": "#5B2A86", "bg": "#F1E8FA", "bd": "#DCC8EF", "dot": "#7A3FB0" }
    },
    "pos-dark": {
      "$note": "Dark variant for the POS screen only.",
      "surface": "#0F1716",
      "raised": "#172322",
      "line": "#24302F",
      "accent": "#2BB3A6",
      "accent-soft": "#5FD0C4",
      "text": "#E6EEED",
      "text-muted": "#AFC0BE",
      "text-subtle": "#8FA5A3"
    }
  },
  "font": {
    "sans": ["Inter", "Kantumruy Pro", "sans-serif"],
    "khmer": ["Kantumruy Pro", "Inter", "sans-serif"],
    "mono": ["JetBrains Mono", "monospace"],
    "weights": [400, 500, 600, 700],
    "numbers": "font-variant-numeric: tabular-nums on all money and quantities",
    "khmer-line-height": "×1.25 of the Latin line height (see type scale lhKm)"
  },
  "type": {
    "pos-total": { "size": 56, "lh": 64, "lhKm": 80, "weight": 700 },
    "page-title": { "size": 28, "lh": 36, "lhKm": 44, "weight": 600 },
    "section-title": { "size": 20, "lh": 28, "lhKm": 34, "weight": 600 },
    "body": { "size": 14, "lh": 22, "lhKm": 26, "weight": 400 },
    "table": { "size": 13, "lh": 20, "lhKm": 24, "weight": 400 },
    "label": { "size": 12, "lh": 16, "lhKm": 20, "weight": 500 },
    "receipt": { "size": 11, "lh": 15, "lhKm": 18, "weight": 400 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48, "16": 64 },
  "grid": { "desktop-columns": 12, "mobile-columns": 4, "mobile-gutter": 16 },
  "radius": { "xs": 2, "sm": 4, "md": 6, "lg": 8, "xl": 10, "2xl": 12, "pill": 999 },
  "shadow": {
    "focus": "0 0 0 3px #CDEBE8",
    "card": "0 8px 24px rgba(23,32,31,.06)",
    "toast": "0 8px 24px rgba(23,32,31,.2)",
    "menu": "0 12px 40px rgba(23,32,31,.16)",
    "dialog": "0 20px 60px rgba(0,0,0,.25)",
    "drawer": "-12px 0 40px rgba(23,32,31,.18)"
  },
  "size": {
    "header-height": 56,
    "sidebar": 248,
    "sidebar-collapsed": 64,
    "control-height": 36,
    "control-height-lg": 46,
    "touch-target-min": 44,
    "mobile-tabbar": 76
  },
  "breakpoints": { "phone": 360, "phone-lg": 414, "tablet": 1024, "desktop": 1366, "desktop-lg": 1920 },
  "usage": [
    "Primary 600 for buttons, links, focus ring, selected rows (primary 50).",
    "Danger only for hard stops, expired, cancelled and destructive confirmation. Never for decoration.",
    "Warning for near-expiry, pending approval and overridable checks.",
    "Safety badge colours (Rx, Controlled, Quarantine, Hamper, Promotion) are reserved.",
    "Money and quantities use neutral 900 at full opacity.",
    "Skeleton shown after 300 ms; nothing before that.",
    "Toasts bottom-right, max 3; success 4 s, failure stays until dismissed.",
    "Field errors on blur and on submit, never while typing."
  ]
}
